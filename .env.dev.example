# Optional settings for `pnpm dev`. Copy to .env.dev (git-ignored) and fill in
# only what you want. With this file empty or absent, `pnpm dev` still starts a
# gateway with the plugin, backed by the fake Alter in dev/fake-alter.mjs.

# --- Chat as a user -----------------------------------------------------------
# The model the agent uses. Without it the gateway runs, but the agent can't
# answer messages.
OPENAI_API_KEY=

# Slack (Socket Mode): both tokens turn Slack on. Setup: deploy/fly/README.md.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Discord: the bot token turns Discord on. Setup: deploy/fly/README.md.
DISCORD_BOT_TOKEN=

# --- Use a real Alter backend instead of the fake -------------------------------
# Set both keys to talk to Alter (see OPERATOR_SETUP.md for minting them).
# Your Alter app must allow http://127.0.0.1:18789/alter/connect/cb as a
# Connect return URL.
OPENCLAW_ALTER_AGENT_API_KEY=
OPENCLAW_ALTER_APP_API_KEY=
# ALTER_BASE_URL=https://backend.alterauth.com
