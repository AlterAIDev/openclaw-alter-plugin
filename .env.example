# Secrets the plugin reads from the gateway process environment at boot.
# Names are configurable via plugin config (agentApiKeyEnv, appApiKeyEnv,
# stateHmacSecretEnv, dbEncryptionKeyEnv); these are the defaults.
#
# NEVER put the values in plugin config — `openclaw plugins config` would
# print them. See OPERATOR_SETUP.md steps 7-8 for how to generate/obtain each.

# Alter agent API key (alter_ak_…; legacy alter_key_…). Minted in the Alter
# portal (https://portal.alterauth.com) under your app's API Keys.
OPENCLAW_ALTER_AGENT_API_KEY=

# Alter app runtime API key (alter_rk_…; legacy alter_key_…).
OPENCLAW_ALTER_APP_API_KEY=

# 64 hex chars (32 bytes): `openssl rand -hex 32`
# HMAC key for signing the Connect state parameter.
OPENCLAW_ALTER_STATE_HMAC_SECRET=

# 64 hex chars (32 bytes): `openssl rand -hex 32`
# AES-256-GCM master key for at-rest JWT encryption. Rotate via
# `openclaw alter db-rotate-key`.
OPENCLAW_ALTER_DB_KEY=
